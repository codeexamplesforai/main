// ─────────────────────────────────────────────────────────────────────────
// opencode.jsonc — example config additions for the fsd-architect package
// ─────────────────────────────────────────────────────────────────────────
//
// Save as ~/.config/opencode/opencode.jsonc (global) or
// .opencode/opencode.jsonc (project-scoped). OpenCode accepts .json and .jsonc;
// this file uses .jsonc for comments. If you already have a config, MERGE the
// sections below — don't replace.
//
// The four agents, the skill, and the four slash commands are loaded from disk
// automatically once placed in the right folders (see README). This config is
// only for default model, per-agent model overrides, and permissions.

{
  "$schema": "https://opencode.ai/config.json",

  // ───────────── default model ─────────────
  // Used when an agent doesn't specify its own. Pick one variant.
  //
  // (a) frontier closed-source:
  "model": "anthropic/claude-sonnet-4-5",
  //
  // (b) hosted open-weights gateway (uncomment one):
  // "model": "openrouter/qwen/qwen3-coder-32b-instruct",
  // "model": "openrouter/openai/gpt-oss-120b",
  //
  // (c) self-hosted via OpenAI-compatible endpoint:
  // "model": "local/qwen3-coder-32b",

  // ───────────── providers ─────────────
  // Only needed for self-hosted / non-default providers.
  // Delete this block if using Anthropic/OpenAI/OpenRouter directly.
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local (vLLM/Ollama/llama.cpp/LM Studio)",
      "options": {
        // Ollama: http://localhost:11434/v1   vLLM: http://localhost:8000/v1
        // LM Studio: http://localhost:1234/v1  llama.cpp: http://localhost:8080/v1
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3-coder-32b": { "name": "Qwen3-Coder 32B" },
        "gpt-oss-120b":    { "name": "gpt-oss 120B" },
        "gpt-oss-20b":     { "name": "gpt-oss 20B" },
        "gemma-3-27b":     { "name": "Gemma 3 27B" },
        "qwen2.5-coder-14b": { "name": "Qwen2.5-Coder 14B" }
      }
    }
  },

  // ───────────── per-agent model overrides ─────────────
  // Match the model to the job. Discovery and architect benefit most from
  // capability (especially architect). Validator and traceability are
  // structured checking/extraction — smaller models work well and save cost.
  "agent": {

    "fsd-discovery": {
      // Reads business inputs, applies BABOK stakeholder analysis.
      // Multimodal model (Gemma 3, Claude, GPT) helps if sources have BPMN diagrams.
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1
    },

    "fsd-architect": {
      // Writes the FSD. THE most capability-sensitive role — use your strongest model.
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.2
    },

    "fsd-validator": {
      // Binary checking against the quality checklist. Small models work well.
      "model": "local/gpt-oss-20b",
      "temperature": 0.0
    },

    "fsd-traceability": {
      // Structured extraction → RTM tables. Mid models are reliable.
      "model": "local/qwen3-coder-32b",
      "temperature": 0.0
    }

    // All-local cost-saver combo:
    //   discovery   = gemma-3-27b (multimodal for diagrams)
    //   architect   = gpt-oss-120b
    //   validator   = qwen2.5-coder-14b
    //   traceability= qwen3-coder-32b
  },

  // ───────────── permissions ─────────────
  // The agent .md files already declare per-agent permissions. This block sets
  // global defaults. Minimum needed: allow the fsd-authoring skill.
  "permission": {
    "skill": {
      "fsd-authoring": "allow",
      "*": "ask"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc *": "allow"
    }
  }

  // ───────────── (optional) instructions ─────────────
  // To make the built-in plan/build agents aware they can delegate FSD work,
  // point to a shared AGENTS.md:
  //
  // "instructions": ["AGENTS.md"]
}
